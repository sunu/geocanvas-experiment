{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "humanitarian-ttx",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  // The built web app. Everything except /connect/*, /monty/* and /tools/* is served from here, without running the Worker.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/connect/*", "/monty/*", "/tools/*"]
  },
  // Montandon STAC API, the database agent-docs/features.md scopes us to. API keys are secrets:
  // apps/worker/.dev.vars locally, `wrangler secret` (or the deploy workflow) when deployed.
  "vars": { "MONTANDON_BASE_URL": "https://montandon-eoapi-stage.ifrc.org/stac" },
  "secrets": { "required": ["MONTANDON_TOKEN", "OPENCAGE_API_KEY"] },
  // One Durable Object per board (room), with its own SQLite storage.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
