{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "humanitarian-ttx",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  // The built web app. Everything except /connect/*, /monty/*, /tools/*, /notebooks/* and /reliefweb/* is served from here, without running the Worker.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/connect/*", "/monty/*", "/tools/*", "/notebooks/*", "/reliefweb/*"]
  },
  // Montandon STAC API, the database agent-docs/features.md scopes us to, and Notebook Factory (published
  // notebook runs; read anonymously). API keys are secrets: apps/worker/.dev.vars locally, `wrangler secret`
  // (or the deploy workflow) when deployed.
  "vars": {
    "MONTANDON_BASE_URL": "https://montandon-eoapi-stage.ifrc.org/stac",
    "NOTEBOOK_FACTORY_URL": "https://notebook-factory-staging.montandondata.org",
    // The board agent's model on OpenRouter: a low-cost model that can call tools (plans/plan-008.md).
    "AGENT_MODEL": "z-ai/glm-5.3-flash"
  },
  // OPENROUTER_API_KEY: without it, the agent answers that it is not configured.
  "secrets": { "required": ["MONTANDON_TOKEN", "OPENROUTER_API_KEY", "OPENCAGE_API_KEY"] },
  // One Durable Object per board (room), with its own SQLite storage.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
