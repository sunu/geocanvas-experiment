{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "humanitarian-ttx",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  // The agent's skills are Markdown files, imported as text (packages/plugins/src/skills/).
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // The built web app. The Worker runs first for every request, so the password (SITE_PASSWORD, src/password.ts)
  // covers the pages too; paths it does not handle are served from these assets through the binding.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Montandon STAC API, the database agent-docs/features.md scopes us to, and Notebook Factory (published
  // notebook runs; read anonymously). API keys are secrets: apps/worker/.dev.vars locally, `wrangler secret`
  // (or the deploy workflow) when deployed.
  "vars": {
    "MONTANDON_BASE_URL": "https://montandon-eoapi-stage.ifrc.org/stac",
    "NOTEBOOK_FACTORY_URL": "https://notebook-factory-staging.montandondata.org",
    "OPENEO_BASE_URL": "https://api.explorer.eopf.copernicus.eu/openeo",
    // Empty on purpose: because of `secrets.required` below, Wrangler passes .dev.vars entries to the Worker only if
    // they are listed there or declared here. openEO is optional, so these are not required (a required secret
    // fails the first deploy of every branch Worker). Locally, .dev.vars overrides them; deployed, they stay empty.
    "OPENEO_USER": "",
    "OPENEO_PASS": "",
    // The board agent's model on OpenRouter: a low-cost model that can call tools (plans/plan-008.md).
    "AGENT_MODEL": "openai/gpt-6-luna"
  },
  // OPENROUTER_API_KEY: without it, the agent answers that it is not configured. HAPI_APP_IDENTIFIER is
  // base64("app name:email") for HDX HAPI; not a key, but it carries the email (apps/worker/src/hapi.ts).
  // SITE_PASSWORD (src/password.ts) is an optional secret, listed in neither place: without it, nothing is checked.
  // A var of the same name would make every deploy after the first warn that it replaces the secret. Locally,
  // pass it with `npm run dev -w apps/worker -- --var SITE_PASSWORD:<password>`, since .dev.vars entries not listed here are dropped.
  "secrets": { "required": ["MONTANDON_TOKEN", "OPENROUTER_API_KEY", "OPENCAGE_API_KEY", "HAPI_APP_IDENTIFIER"] },
  // One Durable Object per board (room), with its own SQLite storage.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // Uploaded files (src/uploads.ts). No bucket_name: `wrangler deploy` makes one per Worker, named
  // <worker>-uploads, so each branch's Worker has its own uploads as it has its own rooms. The deploy token
  // needs R2 edit permission for that. `wrangler dev` keeps them in .wrangler/.
  "r2_buckets": [{ "binding": "UPLOADS" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
