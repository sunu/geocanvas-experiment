# OpenRouter key for the NL gateway and the eval runner. OPENROUTER_API_KEY also works.
OPENROUTER_KEY=
# Optional model overrides
# NL_DECIDER_MODEL=typesafe/jev-1.14
# NL_EXTRACTOR_MODEL=mistralai/mistral-nemo
# NL_EMBED_MODEL=sentence-transformers/all-minilm-l6-v2
# NL_GATEWAY_PORT=8787
# Montandon (IFRC Monty STAC API) for real disaster data. The gateway adds the token; the browser never sees it.
MONTANDON_BASE_URL=https://montandon-eoapi.ifrc.org/stac
MONTANDON_TOKEN=
